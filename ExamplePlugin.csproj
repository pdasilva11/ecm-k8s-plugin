<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>MyCompany.Integrations.VaultPlugin</RootNamespace>
    <OutputType>Exe</OutputType>
    <AssemblyName>VaultECMPlugin</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="BeyondTrustECMSDK">
      <HintPath>lib/BeyondTrustECMSDK.dll</HintPath>
    </Reference>
    <Reference Include="BeyondTrustECMService">
      <HintPath>lib/BeyondTrustECMService.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <None Include="lib/*.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
